# Local Deployment Configuration
# Copy to .env.local and fill in values
# This file is gitignored - never commit real values
#
# Run `npm run verify:operator-config` after filling this in to check that every operator var the
# production-promotion path reads is present and not left at a placeholder value. It reports every
# gap in one pass instead of failing one variable at a time across repeated deploy attempts.

# =============================================================================
# STAGING DEPLOYMENT TARGET (used by `npm run deploy:staging`)
# =============================================================================

# Hostname for a private non-production deploy target.
STAGING_HOST=staging-host.example.invalid

# SSH user for the private deploy target.
STAGING_USER=

# Path to SSH private key for staging access
STAGING_SSH_KEY=

# SSH port (optional, default 22)
STAGING_PORT=22

# Optional: override smoke test URL used by deploy:staging
# Default comes from config/deploy-targets.local.json.
# STAGING_SMOKE_URL=https://staging.classroompath.example.invalid

# Optional: prefer release-candidate images already published for origin/main.
# Allowed values: release-candidate, source-build
# Default: release-candidate
# Use source-build only for explicit debug/recovery sessions; normal promotions
# should fail rather than silently rebuilding from source on staging.
# STAGING_IMAGE_MODE=release-candidate

# Optional: GHCR credentials for pulling release-candidate images if the
# packages are private. Leave unset if the images are public.
# STAGING_GHCR_USERNAME=your-github-username
# STAGING_GHCR_TOKEN=

# Optional: local overrides for the staging billing block.
# If omitted, deploy:staging reuses the current values from
# /srv/classroompath/app/config/.env on the staging host for that execution.
# CP_BILLING_MODE=stripe
# CP_PLATFORM_ADMIN_EMAILS=ops@example.com

# =============================================================================
# PRODUCTION DEPLOYMENT TARGET (used by the local production-promotion path;
# see docs/runbooks/deploy-production.md)
# =============================================================================

# Required: local root path for production deploy state (release-state,
# current-images.env). Read by scripts/deploy-production-remote.sh and the
# production preflight/readiness scripts.
CLASSROOMPATH_DEPLOY_ROOT=

# Production SSH hostname. Optional: auto-derived from
# config/deploy-targets.local.json when omitted.
# DEPLOY_HOST=classroompath.example.invalid

# Required: SSH user for the production deploy target (no default).
DEPLOY_USER=

# Path to SSH private key for production access.
# Optional: defaults to ~/.ssh/classroompath_deploy when unset and that file exists.
# DEPLOY_SSH_KEY=~/.ssh/classroompath_deploy

# SSH port for production (optional, default 22)
# DEPLOY_PORT=22

# =============================================================================
# WINDOWS RUNNER DIRECT DIAGNOSTICS
# =============================================================================
# These are loaded automatically by scripts/run-windows-ajax-direct.mjs at
# startup (process.env wins over .env.local, so exported env vars take precedence).
# Also read by scripts/lib/release-status-collector.mjs to decide whether the
# promotion gate's operational-target check considers the Windows runner target real.

# Proxmox SSH host alias or hostname for qm guest exec commands.
# Pass as --proxmox-host or set WINDOWS_RUNNER_PROXMOX_HOST to override.
PROXMOX_SSH_ALIAS=

# Proxmox host. Preferred over PROXMOX_SSH_ALIAS when both are set; same qm
# guest exec path used for Windows pre-promotion evidence collection.
PROXMOX_HOST=

# VMID of the Windows runner VM on Proxmox.
# Required unless --vmid is passed on the CLI.
WINDOWS_RUNNER_VMID=

# Optional: snapshot name used to roll back the Windows runner before a run.
WINDOWS_RUNNER_BASELINE_SNAPSHOT=

# Post-production Windows canary: when --skip-when-canary-token-absent is
# passed (added automatically by the release orchestrator), the script skips
# the canary gracefully if CP_CLIENT_CANARY_ADMIN_TOKEN is absent.
# In CI, CP_CLIENT_CANARY_ADMIN_TOKEN must be a repository secret.
# Locally, set it here only if you have a valid canary token.
# CP_CLIENT_CANARY_ADMIN_TOKEN=
