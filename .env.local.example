# Local Deployment Configuration
# Copy to .env.local and fill in values
# This file is gitignored - never commit real values

# =============================================================================
# PRIVATE DEPLOYMENT TARGETS
# =============================================================================

# Hostname for a private non-production deploy target.
STAGING_HOST=staging-host.example.invalid

# SSH user for the private deploy target.
STAGING_USER=

# Path to SSH private key for staging access
STAGING_SSH_KEY=

# SSH port (optional, default 22)
STAGING_PORT=22

# Optional: override smoke test URL used by deploy:staging
# Default comes from config/deploy-targets.local.json.
# STAGING_SMOKE_URL=https://staging.classroompath.example.invalid

# Optional: prefer release-candidate images already published for origin/main.
# Allowed values: release-candidate, source-build
# Default: release-candidate
# Use source-build only for explicit debug/recovery sessions; normal promotions
# should fail rather than silently rebuilding from source on staging.
# STAGING_IMAGE_MODE=release-candidate

# Optional: GHCR credentials for pulling release-candidate images if the
# packages are private. Leave unset if the images are public.
# STAGING_GHCR_USERNAME=your-github-username
# STAGING_GHCR_TOKEN=

# Optional: local overrides for the staging billing block.
# If omitted, deploy:staging reuses the current values from
# /srv/classroompath/app/config/.env on the staging host for that execution.
# CP_BILLING_MODE=stripe
# CP_PLATFORM_ADMIN_EMAILS=ops@example.com
