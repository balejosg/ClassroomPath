# ClassroomPath Caddyfile
# Serves SPA and reverse proxies API

classroompath.duckdns.org {
    # Automatic HTTPS via Let's Encrypt

    # API endpoints - reverse proxy to Node.js
    handle /api/* {
        reverse_proxy localhost:3000
    }
    handle /trpc/* {
        reverse_proxy localhost:3000
    }
    handle /health* {
        reverse_proxy localhost:3000
    }
    handle /w/* {
        reverse_proxy localhost:3000
    }

    # SPA static files
    handle {
        root * /var/www/classroompath/spa
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/classroompath.log
        format json
    }
}
