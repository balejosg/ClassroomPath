# ClassroomPath Instance Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Server Configuration
# =============================================================================

# Port for the API server
PORT=3000

# Public URL where the API is accessible for local private evaluation.
# Deployed environments must use private, untracked configuration.
PUBLIC_URL=https://classroompath.example.invalid

# JWT secret for authentication (generate with: openssl rand -hex 64)
JWT_SECRET=

# ClassroomPath session policy: 24-hour web session, 30-day installed app refresh session.
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=30d

# Google OAuth client id (required to show the Google sign-in button)
GOOGLE_CLIENT_ID=

# =============================================================================
# REQUIRED: Database
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/classroompath

# =============================================================================
# REQUIRED: CORS (allowed origins for the SPA)
# =============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=https://classroompath.example.invalid

# =============================================================================
# OPTIONAL: GitHub Integration (legacy - whitelists now stored in database)
# =============================================================================

# These are only needed if you still use GitHub for whitelist storage
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=

# =============================================================================
# OPTIONAL: Push Notifications (Web Push)
# =============================================================================

# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# =============================================================================
# OPTIONAL: Logging
# =============================================================================

# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# =============================================================================
# OPTIONAL: Timezone
# =============================================================================

# Timezone used to evaluate schedules (IANA timezone name)
# Examples: Europe/Madrid, America/Mexico_City
SCHEDULE_TIMEZONE=Europe/Madrid

# =============================================================================
# OPTIONAL: Rate Limiting
# =============================================================================

# Max requests per window (default: 100)
RATE_LIMIT_MAX=100

# Window size in minutes (default: 15)
RATE_LIMIT_WINDOW_MINUTES=15

# =============================================================================
# CLASSROOMPATH GATEWAY (Multi-tenancy)
# =============================================================================

# Port for the ClassroomPath gateway API
CP_PORT=3001

# Internal URL for OpenPath API (used by gateway)
OPENPATH_API_URL=http://api:3000
# Canonical OpenPath URL carried into offline-installer payloads
OPENPATH_URL=http://api:3000

# =============================================================================
# Windows Offline Installer
# =============================================================================

# Pinned OpenPath release metadata. Provisioning requires all four values to
# describe the same release; never use latest or infer commit from version.
CP_OFFLINE_INSTALLER_TEMPLATE_VERSION=
CP_OFFLINE_INSTALLER_TEMPLATE_COMMIT=
CP_OFFLINE_INSTALLER_TEMPLATE_RELEASE_TAG=
CP_OFFLINE_INSTALLER_TEMPLATE_SHA256=

# Docker deploy-side host directory for the provisioned template bind mount.
# Runtime container paths are fixed by docker-compose.yml below.
# Relative to docker/docker-compose.yml and the deploy preflight's docker cwd.
CP_OFFLINE_INSTALLER_TEMPLATE_HOST_DIR=../var/windows-offline-installer/templates
CP_OFFLINE_INSTALLER_TEMPLATE_DIR=/app/var/windows-offline-installer/templates
CP_OFFLINE_INSTALLER_ARTIFACTS_DIR=/app/var/windows-offline-installer/artifacts

CP_OFFLINE_INSTALLER_TOKEN_TTL_HOURS=24
CP_OFFLINE_INSTALLER_DOWNLOAD_TTL_MINUTES=10
CP_OFFLINE_INSTALLER_DOWNLOAD_MAX_ATTEMPTS=3

# Deprecated compatibility fallback. New deployments must use the separated
# template/artifact directories above.
# CP_OFFLINE_INSTALLER_TEMPLATE_CACHE_DIR=

# Optional manual override for the Linux agent package version that
# enrollment/bootstrap must install. Release-candidate and production deploys
# inject this automatically from the OpenPath release tag contained in the
# current submodule and fail closed if Linux runtime changes outpace that tag.
OPENPATH_LINUX_AGENT_VERSION=

# Optional: allow OpenPath API to authenticate REST endpoints via cookies.
# When using ClassroomPath's HttpOnly cookie sessions, this enables upstream
# OpenPath REST endpoints (e.g. /api/enroll/*) that still expect JWT auth.
# Example: cp_access_token
OPENPATH_ACCESS_TOKEN_COOKIE_NAME=

# =============================================================================
# EMAIL DELIVERY
# =============================================================================

# Resend API key for transactional emails (required for real delivery in staging/production)
RESEND_API_KEY=

# Verified sender for transactional emails (required with RESEND_API_KEY)
RESEND_FROM_EMAIL=

# Test-only override to mock delivery without hitting Resend
CP_FAKE_EMAIL_DELIVERY=

# Deploy preflight policy. Runtime deploy scripts set this automatically.
# Allowed: required, skip
CP_EMAIL_PREFLIGHT_MODE=

# =============================================================================
# BILLING
# =============================================================================

# Comma-separated allowlist for platform administrators who can approve manual billing exceptions
CP_PLATFORM_ADMIN_EMAILS=

# Secret token for the post-release client canary to approve only canary-scoped manual billing requests
CP_CLIENT_CANARY_ADMIN_TOKEN=

# Billing mode: manual_only for public-center/manual activation, stripe for online checkout
CP_BILLING_MODE=manual_only

# Stripe secret key and webhook signing secret for Checkout (required only in stripe mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Annual subscription price IDs by classroom tier
STRIPE_ANNUAL_PRICE_1_10=
STRIPE_ANNUAL_PRICE_11_25=
STRIPE_ANNUAL_PRICE_26_50=
STRIPE_ANNUAL_PRICE_51_100=

# One-time onboarding price IDs by classroom tier
STRIPE_ONBOARDING_PRICE_1_25=
STRIPE_ONBOARDING_PRICE_26_100=

# One-time pilot checkout price ID
STRIPE_PILOT_PRICE=
