# ClassroomPath Instance Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Server Configuration
# =============================================================================

# Port for the API server
PORT=3000

# Public URL where the API is accessible (for generating whitelist URLs)
PUBLIC_URL=https://classroompath.duckdns.org

# JWT secret for authentication (generate with: openssl rand -hex 64)
JWT_SECRET=

# =============================================================================
# REQUIRED: Database
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/classroompath

# =============================================================================
# REQUIRED: CORS (allowed origins for the SPA)
# =============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=https://classroompath.duckdns.org

# =============================================================================
# REQUIRED: GitHub Integration (for whitelist storage)
# =============================================================================

# GitHub Personal Access Token with repo scope
GITHUB_TOKEN=

# GitHub owner/organization for whitelist repos
GITHUB_OWNER=

# GitHub repository name for whitelists
GITHUB_REPO=

# =============================================================================
# OPTIONAL: Push Notifications (Web Push)
# =============================================================================

# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# =============================================================================
# OPTIONAL: Logging
# =============================================================================

# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# =============================================================================
# OPTIONAL: Rate Limiting
# =============================================================================

# Max requests per window (default: 100)
RATE_LIMIT_MAX=100

# Window size in minutes (default: 15)
RATE_LIMIT_WINDOW_MINUTES=15
