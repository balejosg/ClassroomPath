# graphify scan exclusions (gitignore syntax).
# IMPORTANT: when this file exists graphify ignores .gitignore entirely, so it
# must repeat the .gitignore patterns and add graph-only exclusions on top.
# Keep in sync with .gitignore.

# --- graph-only exclusions ---
# upstream/ is the vendored OpenPath core — it has its own knowledge graph at
# the workspace root (../graphify-out). Including it here would triple the
# graph and blur the wrapper boundary.
upstream/
graphify-out/

# --- mirrored from .gitignore ---
