# syntax=docker/dockerfile:1.7
# ClassroomPath release verifier image
ARG NODE_IMAGE=node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

FROM ${NODE_IMAGE}
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package*.json ./
COPY upstream/openpath/tsconfig.base.json ./upstream/openpath/tsconfig.base.json
COPY api/package*.json ./api/
COPY react-spa/package*.json ./react-spa/
COPY upstream/openpath/shared/package*.json ./upstream/openpath/shared/
COPY upstream/openpath/react-spa/package*.json ./upstream/openpath/react-spa/
COPY upstream/openpath/api/package*.json ./upstream/openpath/api/

RUN --mount=type=cache,target=/root/.npm set -eux; \
  for attempt in 1 2 3; do \
    npm ci --no-audit --no-fund && break; \
    if [ "$attempt" -eq 3 ]; then exit 1; fi; \
    echo "npm ci failed on attempt $attempt, retrying..." >&2; \
    rm -rf node_modules; \
    sleep $((attempt * 5)); \
  done

RUN npx playwright install --with-deps chromium && chown -R node:node /ms-playwright && chown node:node /app
COPY --chown=node:node . .
USER node
CMD ["node", "--version"]
