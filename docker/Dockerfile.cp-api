# syntax=docker/dockerfile:1.7
# ClassroomPath Gateway API
ARG NODE_IMAGE=node@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
COPY package*.json ./
COPY contracts/package*.json ./contracts/
COPY presenters/package*.json ./presenters/
COPY upstream/openpath/tsconfig.base.json ./upstream/openpath/tsconfig.base.json
COPY api/package*.json ./api/
COPY react-spa/package*.json ./react-spa/
COPY upstream/openpath/shared/package*.json ./upstream/openpath/shared/
COPY upstream/openpath/react-spa/package*.json ./upstream/openpath/react-spa/
COPY upstream/openpath/api/package*.json ./upstream/openpath/api/

# Use npm ci so workspaces are linked deterministically.
# Release builds occasionally hit transient registry resets, so retry before
# failing the image build.
RUN --mount=type=cache,target=/root/.npm set -eux; \
  for attempt in 1 2 3; do \
    npm ci --no-audit --no-fund && break; \
    if [ "$attempt" -eq 3 ]; then exit 1; fi; \
    echo "npm ci failed on attempt $attempt, retrying..." >&2; \
    rm -rf node_modules; \
    sleep $((attempt * 5)); \
  done

# Copy only the build inputs for the gateway so workflow/test changes do not
# invalidate the slow release-candidate image cache.
COPY contracts/tsconfig.json ./contracts/tsconfig.json
COPY contracts/src ./contracts/src
COPY presenters/tsconfig.json ./presenters/tsconfig.json
COPY presenters/src ./presenters/src
COPY api/tsconfig.json ./api/tsconfig.json
COPY api/src ./api/src
COPY react-spa/tsconfig.json ./react-spa/tsconfig.json
COPY react-spa/vite.config.ts ./react-spa/vite.config.ts
COPY react-spa/postcss.config.js ./react-spa/postcss.config.js
COPY react-spa/index.html ./react-spa/index.html
COPY react-spa/public ./react-spa/public
COPY react-spa/src ./react-spa/src
COPY upstream/openpath/shared/tsconfig.json ./upstream/openpath/shared/tsconfig.json
COPY upstream/openpath/shared/src ./upstream/openpath/shared/src
COPY upstream/openpath/react-spa/tsconfig.json ./upstream/openpath/react-spa/tsconfig.json
COPY upstream/openpath/react-spa/vite.config.ts ./upstream/openpath/react-spa/vite.config.ts
COPY upstream/openpath/react-spa/openpath.css ./upstream/openpath/react-spa/openpath.css
COPY upstream/openpath/react-spa/public-auth.ts ./upstream/openpath/react-spa/public-auth.ts
COPY upstream/openpath/react-spa/public-google.ts ./upstream/openpath/react-spa/public-google.ts
COPY upstream/openpath/react-spa/public-i18n.ts ./upstream/openpath/react-spa/public-i18n.ts
COPY upstream/openpath/react-spa/public-shell.ts ./upstream/openpath/react-spa/public-shell.ts
COPY upstream/openpath/react-spa/public-ui.ts ./upstream/openpath/react-spa/public-ui.ts
COPY upstream/openpath/react-spa/postcss.config.js ./upstream/openpath/react-spa/postcss.config.js
COPY upstream/openpath/react-spa/index.html ./upstream/openpath/react-spa/index.html
COPY upstream/openpath/react-spa/src ./upstream/openpath/react-spa/src

# Build everything
RUN npm run build --workspace=@openpath/shared
RUN npm run build --workspace=@classroompath/contracts
RUN npm run build --workspace=@classroompath/presenters
RUN npm run build --workspace=@classroompath/react-spa
RUN npm run build --workspace=@classroompath/api

FROM ${NODE_IMAGE}
RUN apk add --no-cache curl
WORKDIR /app
COPY package*.json ./
COPY contracts/package*.json ./contracts/
COPY presenters/package*.json ./presenters/
COPY api/package*.json ./api/
COPY react-spa/package*.json ./react-spa/
COPY upstream/openpath/shared/package*.json ./upstream/openpath/shared/

# Install production dependencies for the gateway and shared runtime package.
# Retry to absorb transient npm registry or network failures during release builds.
RUN --mount=type=cache,target=/root/.npm set -eux; \
  for attempt in 1 2 3; do \
    npm ci --no-audit --no-fund --workspace=@classroompath/api --workspace=@classroompath/react-spa --workspace=@openpath/shared --omit=dev && break; \
    if [ "$attempt" -eq 3 ]; then exit 1; fi; \
    echo "npm ci failed on attempt $attempt, retrying..." >&2; \
    rm -rf node_modules; \
    sleep $((attempt * 5)); \
  done

# Copy built files
COPY --from=builder /app/api/dist ./api/dist
# Place SPA dist to match server.ts expectation (../../react-spa/dist from api/dist)
COPY --from=builder /app/react-spa/dist /app/react-spa/dist
COPY --from=builder /app/react-spa/dist-ssr /app/react-spa/dist-ssr

# Shared dependency for production resolution.
# The gateway imports from "@openpath/shared" at runtime, so we must provide it
# as a resolvable Node package (node_modules/@openpath/shared).
RUN mkdir -p node_modules/@openpath/shared
COPY --from=builder /app/upstream/openpath/shared/dist ./node_modules/@openpath/shared/dist
COPY --from=builder /app/upstream/openpath/shared/package.json ./node_modules/@openpath/shared/package.json

# Internal ClassroomPath workspaces are imported by the gateway and SSR runtime.
RUN mkdir -p node_modules/@classroompath/contracts node_modules/@classroompath/presenters
COPY --from=builder /app/contracts/dist ./node_modules/@classroompath/contracts/dist
COPY --from=builder /app/contracts/package.json ./node_modules/@classroompath/contracts/package.json
COPY --from=builder /app/presenters/dist ./node_modules/@classroompath/presenters/dist
COPY --from=builder /app/presenters/package.json ./node_modules/@classroompath/presenters/package.json

# Runtime environment policy data is loaded by api/dist/config at startup.
COPY config/runtime-environment-policy.catalog.json ./config/runtime-environment-policy.catalog.json

# Copy database tools
COPY api/drizzle.config.ts ./api/
COPY api/src/db ./api/src/db

RUN mkdir -p /app/data /app/react-spa/dist/downloads && chown -R node:node /app

WORKDIR /app/api
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -fsS http://127.0.0.1:3001/cp/ready || exit 1
CMD ["node", "dist/server.js"]
