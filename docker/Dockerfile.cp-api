# ClassroomPath Gateway API
FROM node:20-alpine AS builder

WORKDIR /app

# Copy and install dependencies (including dev for build)
COPY api/package*.json ./
RUN npm ci

# Copy source and build
COPY api/ ./
RUN npm run build

# Production stage
FROM node:20-alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

WORKDIR /app

# Copy package files and install prod deps only
COPY api/package*.json ./
RUN npm ci --omit=dev

# Copy built files from builder
COPY --from=builder /app/dist ./dist

# Copy drizzle config and source for migrations (db:push needs schema source)
COPY api/drizzle.config.ts ./
COPY api/src/db ./src/db

EXPOSE 3001

CMD ["node", "dist/server.js"]
