# syntax=docker/dockerfile:1.7
# ClassroomPath migration runner image
ARG NODE_IMAGE=node@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8

FROM ${NODE_IMAGE}
WORKDIR /app

COPY package*.json ./
COPY upstream/openpath/tsconfig.base.json ./upstream/openpath/tsconfig.base.json
COPY api/package*.json ./api/
COPY react-spa/package*.json ./react-spa/
COPY upstream/openpath/shared/package*.json ./upstream/openpath/shared/
COPY upstream/openpath/react-spa/package*.json ./upstream/openpath/react-spa/
COPY upstream/openpath/api/package*.json ./upstream/openpath/api/

RUN --mount=type=cache,target=/root/.npm set -eux; \
  for attempt in 1 2 3; do \
    npm ci --no-audit --no-fund && break; \
    if [ "$attempt" -eq 3 ]; then exit 1; fi; \
    echo "npm ci failed on attempt $attempt, retrying..." >&2; \
    rm -rf node_modules; \
    sleep $((attempt * 5)); \
  done

# Copy only the migration/runtime inputs so workflow-only changes do not
# invalidate the release-candidate migrations cache.
RUN chown node:node /app
COPY --chown=node:node api/drizzle.config.ts ./api/drizzle.config.ts
COPY --chown=node:node api/drizzle ./api/drizzle
COPY --chown=node:node api/tsconfig.json ./api/tsconfig.json
COPY --chown=node:node api/scripts ./api/scripts
COPY --chown=node:node api/src ./api/src
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node upstream/openpath/shared/tsconfig.json ./upstream/openpath/shared/tsconfig.json
COPY --chown=node:node upstream/openpath/shared/src ./upstream/openpath/shared/src
COPY --chown=node:node upstream/openpath/api/drizzle.config.ts ./upstream/openpath/api/drizzle.config.ts
COPY --chown=node:node upstream/openpath/api/tsconfig.json ./upstream/openpath/api/tsconfig.json
COPY --chown=node:node upstream/openpath/api/tsconfig.build.json ./upstream/openpath/api/tsconfig.build.json
COPY --chown=node:node upstream/openpath/api/drizzle ./upstream/openpath/api/drizzle
COPY --chown=node:node upstream/openpath/api/scripts ./upstream/openpath/api/scripts
COPY --chown=node:node upstream/openpath/api/src ./upstream/openpath/api/src
USER node
ENTRYPOINT ["sh", "scripts/run-migrations-image.sh"]
