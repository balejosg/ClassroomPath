# Use Node.js 20 alpine as base for building
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package manifests for all workspaces
COPY package*.json ./
COPY api/package*.json ./api/
COPY spa/package*.json ./spa/
COPY react-spa/package*.json ./react-spa/

# Install dependencies
RUN npm ci

# Copy source code
COPY api/ ./api/
COPY spa/ ./spa/
COPY react-spa/ ./react-spa/

# Build the api package
RUN npm run build -w @openpath/api

# Final production image
FROM node:20-alpine

WORKDIR /app

# Copy built files and production dependencies
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/api/dist ./api/dist
COPY --from=builder /app/api/package.json ./api/package.json

EXPOSE 3000

# Start the API
CMD ["node", "api/dist/server.js"]
