# syntax=docker/dockerfile:1.7

# OpenPath Core API
ARG NODE_IMAGE=node@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8

FROM ${NODE_IMAGE} AS builder
WORKDIR /app

# Copy dependency manifests separately so script-only metadata changes in the
# OpenPath monorepo do not invalidate the expensive install layers.
COPY package-lock.json ./
COPY package.docker.json ./package.json
COPY tsconfig.base.json ./

# Copy manifests
COPY shared/package.docker.json ./shared/package.json
COPY api/package.docker.json ./api/package.json

# Install ALL dependencies for building.
# Retry to tolerate transient registry failures in CI.
RUN --mount=type=cache,target=/root/.npm set -eux; \
  for attempt in 1 2 3; do \
    npm ci --no-audit --no-fund && break; \
    if [ "$attempt" -eq 3 ]; then exit 1; fi; \
    echo "npm ci failed on attempt $attempt, retrying..." >&2; \
    rm -rf node_modules; \
    sleep $((attempt * 5)); \
  done

# Copy source needed for the TypeScript build.
COPY shared/ ./shared/
COPY api/ ./api/

# Build everything
RUN npm run build -w @openpath/shared
RUN npm run build -w @openpath/api

# Final production image
FROM ${NODE_IMAGE}
WORKDIR /app

# Copy dependency manifests
COPY package-lock.json ./
COPY package.docker.json ./package.json
COPY shared/package.docker.json ./shared/package.json
COPY api/package.docker.json ./api/package.json

# Install production dependencies only.
# This links shared because of the "file:" dependency in api/package.json.
RUN --mount=type=cache,target=/root/.npm set -eux; \
  for attempt in 1 2 3; do \
    npm ci --no-audit --no-fund --workspace=@openpath/api --omit=dev && break; \
    if [ "$attempt" -eq 3 ]; then exit 1; fi; \
    echo "npm ci failed on attempt $attempt, retrying..." >&2; \
    rm -rf node_modules; \
    sleep $((attempt * 5)); \
  done

# Restore runtime package metadata and built files
COPY --from=builder /app/api/package.json ./api/package.json
COPY --from=builder /app/shared/package.json ./shared/package.json
COPY --from=builder /app/api/dist ./api/dist
COPY --from=builder /app/shared/dist ./shared/dist

# Keep delivery-only assets out of the expensive builder stage so release-candidate
# API builds can reuse the compile cache when only bootstrap/runtime artifacts change.
COPY windows/ ./windows/
COPY runtime/ ./runtime/
COPY firefox-extension/ ./firefox-extension/
COPY VERSION ./VERSION

RUN mkdir -p \
      /app/data \
      /app/var/windows-offline-installer/templates \
      /app/var/windows-offline-installer/artifacts && \
    chown -R node:node /app && \
    chmod 0755 /app/var/windows-offline-installer/templates && \
    chmod 0700 /app/var/windows-offline-installer/artifacts

EXPOSE 3000
WORKDIR /app/api
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1
CMD ["node", "dist/src/server.js"]
