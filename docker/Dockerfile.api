# OpenPath Core API
ARG NODE_IMAGE=node@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8

FROM ${NODE_IMAGE} AS builder
WORKDIR /app

# Copy root configuration
COPY package*.json ./
COPY tsconfig.base.json ./

# Copy manifests
COPY shared/package*.json ./shared/
COPY api/package*.json ./api/

# Install ALL dependencies for building
RUN npm ci

# Copy source
COPY shared/ ./shared/
COPY api/ ./api/

# Build everything
RUN npm run build -w @openpath/shared
RUN npm run build -w @openpath/api

# Final production image
FROM ${NODE_IMAGE}
WORKDIR /app

# Copy package manifests
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY api/package*.json ./api/

# Install production dependencies only
# This will link shared because of the "file:" dependency in api/package.json
RUN npm ci --workspace=@openpath/api --omit=dev

# Copy the built files into the locations where Node expects them
COPY --from=builder /app/api/dist ./api/dist
COPY --from=builder /app/shared/dist ./shared/dist

EXPOSE 3000
# Updated CMD to match actual build structure (dist/src/server.js)
CMD ["node", "api/dist/src/server.js"]
