# SPA Dockerfile for ClassroomPath
FROM node:20-alpine AS builder

WORKDIR /app

# Copy ClassroomPath API and SPA
COPY api/ ./api/
COPY spa/ ./spa/
COPY package*.json ./

# Copy OpenPath submodule
COPY upstream/ ./upstream/

# Install dependencies for ClassroomPath SPA
WORKDIR /app/spa
RUN npm install

# Patch OpenPath index.html to point to main.ts instead of dist/main.js
# This is required for Vite to build it correctly
RUN sed -i 's/dist\/main.js/src\/main.ts/g' ../upstream/openpath/spa/index.html

# Build ClassroomPath SPA
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy the built SPA files
COPY --from=builder /app/spa/dist /usr/share/nginx/html

# Also copy OpenPath source assets
COPY --from=builder /app/upstream/openpath/spa/css /usr/share/nginx/html/css
COPY --from=builder /app/upstream/openpath/spa/js /usr/share/nginx/html/js

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
