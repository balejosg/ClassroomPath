# SPA Dockerfile for ClassroomPath
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies (copying all packages to ensure workspace links work)
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY api/package*.json ./api/
COPY spa/package*.json ./spa/
COPY upstream/openpath/package*.json ./upstream/openpath/
COPY upstream/openpath/shared/package*.json ./upstream/openpath/shared/
COPY upstream/openpath/api/package*.json ./upstream/openpath/api/
COPY upstream/openpath/spa/package*.json ./upstream/openpath/spa/

# Install dependencies
RUN npm ci

# Copy source
COPY tsconfig.base.json ./
COPY shared/ ./shared/
COPY api/ ./api/
COPY spa/ ./spa/
COPY upstream/ ./upstream/

# Build ClassroomPath SPA
# This uses spa/vite.config.ts which wraps OpenPath SPA
WORKDIR /app/spa
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy the built SPA files
COPY --from=builder /app/spa/dist /usr/share/nginx/html

# Also copy OpenPath source CSS/JS because some legacy pages might use them directly
# (Though Vite should have bundled everything)
COPY --from=builder /app/upstream/openpath/spa/css /usr/share/nginx/html/css
COPY --from=builder /app/upstream/openpath/spa/js /usr/share/nginx/html/js

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
