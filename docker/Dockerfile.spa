ARG NODE_IMAGE=node@sha256:09e2b3d9726018aecf269bd35325f46bf75046a643a66d28360ec71132750ec8
ARG NGINX_IMAGE=nginx@sha256:1d13701a5f9f3fb01aaa88cef2344d65b6b5bf6b7d9fa4cf0dca557a8d7702ba

FROM ${NODE_IMAGE} AS builder

WORKDIR /app

# Copy manifests
COPY package*.json ./
COPY react-spa/package*.json ./react-spa/
COPY api/package*.json ./api/

# Install dependencies
RUN npm ci

# Copy source
COPY . .

# Build SPA
RUN npm run build --workspace=@classroompath/react-spa

FROM ${NGINX_IMAGE}
COPY --from=builder /app/react-spa/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
