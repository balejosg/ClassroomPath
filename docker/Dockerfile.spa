FROM node:20-alpine AS builder

WORKDIR /app

COPY . .

RUN npm install && \
    cd upstream/openpath && npm install && \
    cd ../../spa && npm install

WORKDIR /app/spa
RUN npx vite build

FROM nginx:alpine
COPY --from=builder /app/spa/dist /usr/share/nginx/html
COPY --from=builder /app/upstream/openpath/spa/css /usr/share/nginx/html/css
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
