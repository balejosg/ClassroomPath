# SPA Dockerfile for ClassroomPath
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies for ClassroomPath root
COPY package*.json ./
# We don't have a lockfile for ClassroomPath root that covers everything
# so we'll just install what we need.
# Actually, ClassroomPath root only has devDeps for testing.
RUN npm ci || npm install

# Copy ClassroomPath API and SPA
COPY api/ ./api/
COPY spa/ ./spa/

# Copy OpenPath submodule
COPY upstream/ ./upstream/

# Install dependencies for ClassroomPath SPA
# It needs @trpc/client and also references OpenPath source
WORKDIR /app/spa
RUN npm install

# Build ClassroomPath SPA
# This uses spa/vite.config.ts which wraps OpenPath SPA
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy the built SPA files
COPY --from=builder /app/spa/dist /usr/share/nginx/html

# Also copy OpenPath source CSS/JS because some legacy pages might use them directly
COPY --from=builder /app/upstream/openpath/spa/css /usr/share/nginx/html/css
COPY --from=builder /app/upstream/openpath/spa/js /usr/share/nginx/html/js

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
