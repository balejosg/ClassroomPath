{
  "extends": "../upstream/openpath/react-spa/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@classroompath/trpc-contract": ["../trpc-contract/src/index.ts"],
      "@openpath/openpath.css": ["../upstream/openpath/react-spa/src/index.css"],
      "@openpath/public-auth": ["../upstream/openpath/react-spa/src/public/auth.ts"],
      "@openpath/public-google": ["../upstream/openpath/react-spa/src/public/google.ts"],
      "@openpath/public-shell": ["../upstream/openpath/react-spa/src/public/shell.ts"],
      "@openpath/public-ui": ["../upstream/openpath/react-spa/src/public/ui.ts"],
      "@openpath/api": ["../upstream/openpath/api/src/index.ts"],
      "@openpath/*": ["../upstream/openpath/react-spa/*"],
      "@openpath/shared": ["../upstream/openpath/shared/src"],
      "@openpath/shared/*": ["../upstream/openpath/shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../upstream"]
}
