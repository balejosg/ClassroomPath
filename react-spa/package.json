{
  "name": "@classroompath/react-spa",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/ssr-entry.tsx --outDir dist-ssr",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@classroompath/contracts": "1.0.0",
    "@classroompath/presenters": "1.0.0",
    "@openpath/api": "1.0.4",
    "@openpath/shared": "1.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@trpc/client": "^11.8.0",
    "@trpc/react-query": "^11.8.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.4",
    "react-dom": "^19.0.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.41.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.35.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
