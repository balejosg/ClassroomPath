{
  "name": "classroompath",
  "version": "1.0.0",
  "private": true,
  "description": "ClassroomPath SaaS - DNS whitelist management for educational institutions",
  "author": "balejosg",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "dns",
    "whitelist",
    "classroom",
    "education",
    "saas"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "api",
    "react-spa",
    "upstream/openpath/shared",
    "upstream/openpath/api",
    "upstream/openpath/react-spa"
  ],
  "scripts": {
    "install:all": "npm install && cd upstream/openpath && npm install",
    "build": "cd upstream/openpath && npm run build --workspaces --if-present",
    "build:api": "cd upstream/openpath && npm run build --workspace=@openpath/shared && npm run build --workspace=@openpath/api",
    "build:spa": "cd upstream/openpath && npm run build --workspace=@openpath/shared && npm run build --workspace=@openpath/react-spa",
    "dev": "cd upstream/openpath/api && npm run dev",
    "start": "cd upstream/openpath/api && npm start",
    "test": "cd upstream/openpath && npm test",
    "test:e2e": "npx playwright test",
    "test:e2e:setup": "bash scripts/setup-test-db.sh",
    "test:e2e:ui": "npx playwright test --ui",
    "test:deployment": "node --import tsx --test tests/deployment.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke.test.ts",
    "test:smoke:staging": "SMOKE_TEST_URL=https://classroompath-staging.duckdns.org npm run test:smoke",
    "test:smoke:production": "SMOKE_TEST_URL=https://classroompath.duckdns.org npm run test:smoke",
    "lint": "cd upstream/openpath && npm run lint",
    "typecheck": "cd upstream/openpath && npm run typecheck",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "security:secrets": "secretlint '**/*.{js,ts,tsx,json,yml,yaml,env,env.*}'",
    "security:audit": "npm audit --audit-level=high",
    "size:check": "npm run size --workspace=@openpath/react-spa",
    "verify:full": "bash scripts/verify-full.sh",
    "submodule:update": "git submodule update --remote --merge",
    "prepare": "husky || true"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write",
      "secretlint"
    ],
    "*.{json,yml,yaml,env*}": [
      "secretlint"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.57.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@size-limit/preset-app": "^12.0.0",
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.1",
    "size-limit": "^12.0.0",
    "tsx": "^4.21.0",
    "yaml": "^2.7.1"
  }
}
