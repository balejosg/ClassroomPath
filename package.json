{
  "name": "classroompath",
  "version": "1.0.0",
  "private": true,
  "description": "ClassroomPath SaaS - DNS whitelist management for educational institutions",
  "author": "balejosg",
  "license": "BUSL-1.1",
  "keywords": [
    "dns",
    "whitelist",
    "classroom",
    "education",
    "saas"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "api",
    "react-spa",
    "upstream/openpath/shared",
    "upstream/openpath/api",
    "upstream/openpath/react-spa"
  ],
  "scripts": {
    "install:all": "npm install && cd upstream/openpath && npm install",
    "build": "bash scripts/build-classroompath.sh",
    "build:openpath": "bash scripts/build-openpath.sh",
    "build:api": "cd upstream/openpath && npm run build --workspace=@openpath/shared && npm run build --workspace=@openpath/api",
    "build:spa": "cd upstream/openpath && npm run build --workspace=@openpath/shared && npm run build --workspace=@openpath/react-spa",
    "dev": "cd upstream/openpath/api && npm run dev",
    "start": "cd upstream/openpath/api && npm start",
    "test": "cd upstream/openpath && npm test",
    "test:e2e": "npx playwright test",
    "test:e2e:verify-fast": "E2E_SKIP_DB_PUSH=1 npx playwright test --grep-invert=\"@slow-network|@repro\"",
    "test:e2e:full": "E2E_SKIP_DB_PUSH=1 npx playwright test",
    "test:e2e:mobile": "E2E_SKIP_DB_PUSH=1 npx playwright test --project=chromium --grep=\"@mobile|@responsive\"",
    "test:e2e:setup": "bash scripts/setup-test-db.sh",
    "test:e2e:ui": "npx playwright test --ui",
    "test:deployment": "node --import tsx --test tests/deployment.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke.test.ts",
    "test:smoke:staging": "SMOKE_TEST_URL=https://classroompath-staging.duckdns.org npm run test:smoke",
    "test:smoke:production": "SMOKE_TEST_URL=https://classroompath.duckdns.org npm run test:smoke",
    "lint": "cd upstream/openpath && npm run lint",
    "typecheck": "cd upstream/openpath && npm run typecheck",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "security:secrets": "secretlint '**/*.{js,ts,tsx,json,yml,yaml,env,env.*}'",
    "security:audit": "npm audit --audit-level=high",
    "size:check": "test -d upstream/openpath/react-spa/dist && npm run size --workspace=@openpath/react-spa || echo 'SKIP: upstream/openpath/react-spa/dist not built, skipping size check'",
    "verify:full": "bash scripts/verify-full.sh",
    "db:test:reset": "docker compose -p classroompath_test -f docker/docker-compose.test.yml down -v && docker compose -p classroompath_test -f docker/docker-compose.test.yml up -d postgres",
    "submodule:update": "git submodule update --remote --merge",
    "deploy:staging": "bash scripts/deploy-staging-local.sh",
    "prepare": "husky || true"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write",
      "secretlint"
    ],
    "*.{json,yml,yaml,env*}": [
      "secretlint"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.57.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@size-limit/preset-app": "^12.0.0",
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.1",
    "size-limit": "^12.0.0",
    "tsx": "^4.21.0",
    "underscore": "1.13.8",
    "yaml": "^2.7.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "qs": "^6.14.2",
    "minimatch": "^10.2.1",
    "swagger-jsdoc": {
      "glob": "^11.0.0"
    }
  }
}
