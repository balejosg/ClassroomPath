# Dependencies
**/node_modules

# Build output
**/dist
**/coverage
**/.turbo
**/.vite
**/.eslintcache

# Test artifacts
**/test-results
**/playwright-report

# Dev/test sources (not needed for image builds)
**/tests
**/e2e
.github
.vscode
!tests/
!tests/**/*.ts

# Upstream OpenPath: exclude non-workspace dirs from build context
upstream/openpath/.opencode
upstream/openpath/build
upstream/openpath/dashboard
upstream/openpath/data
upstream/openpath/docs
upstream/openpath/firefox-extension
upstream/openpath/linux
upstream/openpath/spa
upstream/openpath/windows

# Local env / secrets (never bake into images)
.env*
!.env.local.example
!**/.env.example
config/.env*
!config/.env.example

# VCS
.git
.gitignore
.gitattributes

# Logs
**/*.log

# OS
.DS_Store
